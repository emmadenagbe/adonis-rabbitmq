{
  "name": "@emmadenagbe/rabbitmq",
  "description": "RabbitMQ provider for AdonisJS 6 with resilient connections, declarative consumers, and IoC container integration",
  "version": "0.1.0",
  "engines": {
    "node": ">=20.6.0"
  },
  "type": "module",
  "main": "build/index.js",
  "types": "build/index.d.ts",
  "exports": {
    ".": "./build/index.js",
    "./types": "./build/src/types.js",
    "./rabbitmq_provider": "./build/providers/rabbitmq_provider.js",
    "./services/main": "./build/services/main.js"
  },
  "files": [
    "build",
    "!build/bin",
    "!build/tests"
  ],
  "scripts": {
    "clean": "del-cli build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "node --import=ts-node-maintained/register/esm bin/test.ts",
    "prebuild": "npm run clean",
    "build": "tsc",
    "postbuild": "copy-files-from-to",
    "version": "npm run build",
    "prepublishOnly": "npm run build",
    "prepare": "husky",
    "release": "release-it"
  },
  "keywords": [
    "adonisjs",
    "rabbitmq",
    "amqp",
    "amqplib"
  ],
  "author": "",
  "license": "MIT",
  "homepage": "https://github.com/emmadenagbe/ad-rabbitmq#readme",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/emmadenagbe/ad-rabbitmq.git"
  },
  "bugs": {
    "url": "https://github.com/emmadenagbe/ad-rabbitmq/issues"
  },
  "devDependencies": {
    "@adonisjs/core": "^6.14.0",
    "@adonisjs/eslint-config": "^2.0.0",
    "@adonisjs/prettier-config": "^1.4.0",
    "@adonisjs/tsconfig": "^1.4.0",
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@japa/assert": "^3.0.0",
    "@japa/runner": "^3.1.4",
    "@release-it/conventional-changelog": "^12.0.0",
    "@swc/core": "^1.5.7",
    "@types/amqplib": "^0.10.5",
    "@types/node": "^22.5.5",
    "copy-files-from-to": "^3.11.1",
    "del-cli": "^5.1.0",
    "eslint": "^9.10.0",
    "husky": "^9.1.7",
    "prettier": "^3.3.3",
    "release-it": "^21.0.2",
    "ts-node-maintained": "^10.9.4",
    "typescript": "^5.5.4"
  },
  "dependencies": {
    "@poppinss/utils": "^6.8.3",
    "amqp-connection-manager": "^4.1.14",
    "amqplib": "^0.10.4"
  },
  "peerDependencies": {
    "@adonisjs/core": "^6.2.0"
  },
  "publishConfig": {
    "access": "public",
    "tag": "latest"
  },
  "prettier": "@adonisjs/prettier-config",
  "copyFiles": [
    {
      "from": "stubs/**/*.stub",
      "to": "build/stubs/"
    }
  ],
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  },
  "release-it": {
    "git": {
      "requireCleanWorkingDir": true,
      "requireUpstream": true,
      "commitMessage": "chore(release): ${version}",
      "tagAnnotation": "v${version}",
      "push": true,
      "tagName": "v${version}"
    },
    "github": {
      "release": true
    },
    "npm": {
      "publish": true,
      "skipChecks": true
    },
    "plugins": {
      "@release-it/conventional-changelog": {
        "preset": {
          "name": "angular"
        },
        "infile": "CHANGELOG.md"
      }
    }
  }
}
